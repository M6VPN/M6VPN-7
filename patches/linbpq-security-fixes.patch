+	}
+
+	return 1;
+#else
+	FILE * hFile = fopen("/dev/urandom", "rb");
+	int ReadLen;
+
+	if (hFile == 0)
+		return 0;
+
+	ReadLen = (int)fread(Buffer, 1, Len, hFile);
+	fclose(hFile);
+
+	return ReadLen == Len;
+#endif
